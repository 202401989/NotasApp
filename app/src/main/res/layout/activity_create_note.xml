<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#F5F7FB">

    <TextView
        android:id="@+id/txtCreateTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Crear una nota"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#244A73"
        android:gravity="center"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/edtNoteTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Título de la nota"
        android:inputType="textCapSentences"
        android:padding="14dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/txtCreateTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/edtNoteContent"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:hint="Escribe el contenido de tu nota"
        android:gravity="top|start"
        android:inputType="textMultiLine|textCapSentences"
        android:padding="14dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/edtNoteTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnSaveNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Guardar nota"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/edtNoteContent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progressCreateNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnSaveNote"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtCreateMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="14sp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/progressCreateNote"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

